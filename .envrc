# このリポジトリ内では GitHub 認証を auditive-tokyo アカウントに固定する。
# GH_TOKEN は gh のアクティブアカウントより優先され、
# credential.helper=!gh auth git-credential もこの token を使うため、
# gh のアクティブが何であっても常に auditive-tokyo で push できる。
# 有効化: このディレクトリで `direnv allow` を一度実行する。
export GH_TOKEN=$(gh auth token --user auditive-tokyo)

# このリポジトリ内では GCP プロジェクトを faredgelabs に固定する。
# gcloud の設定はグローバルに1つしかないので、`gcloud config set project` で
# 切り替えると farm-scoring-system のディレクトリに戻っても FarEdge を
# 向いたままになる。環境変数はアクティブな設定より優先されるため、
# cd するだけで入れ替わり、他のリポジトリの作業に影響しない。
#
# 2つ必要なのは読む側が違うから:
#   CLOUDSDK_CORE_PROJECT  gcloud CLI が見る
#   GOOGLE_CLOUD_PROJECT   Python のクライアントライブラリが見る
# 片方だけだと gcloud は正しいのに main.py が別プロジェクトを触り得る。
#
# Terraform はここに依存させない。provider に project を直接書く
# (どのディレクトリから apply しても向き先が変わらないようにするため)。
export CLOUDSDK_CORE_PROJECT=faredgelabs
export GOOGLE_CLOUD_PROJECT=$CLOUDSDK_CORE_PROJECT
